generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id             String   @id @default(cuid())
  name           String
  token          String   @unique // BAC-XXXX-XXXX-XXXX-XXXX secret login token
  createdAt      DateTime @default(now())
  lastActiveAt   DateTime @default(now())
  // GitHub pairing (PaT + repo) — enables personal cloud backup & real-time sync
  githubToken    String?
  githubRepo     String?
  githubOwner    String?
  githubSyncedAt DateTime?
  autoSync       Boolean  @default(true)
  // Custom AI provider (student's own OpenAI-compatible key) — overrides the
  // deployment-wide AI for this student's chats/quizzes/flashcards
  aiProviderId   String?  // preset id: zai-coding | nvidia-nim | opencode-zen | openadapter | custom
  aiBaseUrl      String?
  aiApiKey       String?
  aiModel        String?
  aiVerifiedAt   DateTime?
  // Model discovery state (source of truth = provider's live API response)
  aiModelsCache    String?   @default("[]") // JSON ProviderModel[] (trimmed, capped)
  aiModelsFetchedAt DateTime?
  aiRetiredModels  String?   @default("[]") // JSON string[] — models the provider retired (HTTP 410 / definitive 404)
  conversations  Conversation[]
  quizAttempts   QuizAttempt[]
  lessonProgress LessonProgress[]
  flashcardStats FlashcardStat[]
}

model Conversation {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  mode      String   @default("coach") // coach | skill | interviewer
  skillSlug String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  createdAt      DateTime     @default(now())
}

model QuizAttempt {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillSlug String
  category  String
  score     Int
  total     Int
  details   String   @default("[]") // JSON array of {question, chosen, correct, isCorrect}
  createdAt DateTime @default(now())
}

model LessonProgress {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId    String // skill slug
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([studentId, itemId])
}

model FlashcardStat {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillSlug String
  known     Int      @default(0)
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillSlug])
}
